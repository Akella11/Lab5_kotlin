import android.widget.EditText
import android.widget.TextView
import androidx.appcompat.app.AppCompatActivity


class TaskActivity1 : AppCompatActivity() {

    // Модель для зберігання даних
    data class ReliabilityIndicators(
        val omega: Double,
        val tV: Double,
        val mu: Double,
        val tP: Double
    )

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_task1)

        // Ініціалізація даних
        val dataIndicators = mapOf(
            "ПЛ-110 кВ" to ReliabilityIndicators(0.007, 10.0, 0.167, 35.0),
            "ПЛ-35 кВ" to ReliabilityIndicators(0.02, 8.0, 0.167, 35.0),
            "ПЛ-10 кВ" to ReliabilityIndicators(0.02, 10.0, 0.167, 35.0),
            "КЛ-10 кВ (траншея)" to ReliabilityIndicators(0.03, 44.0, 1.0, 9.0),
            "КЛ-10 кВ (кабельний канал)" to ReliabilityIndicators(0.005, 17.5, 1.0, 9.0),
            "T-110 кВ" to ReliabilityIndicators(0.015, 100.0, 1.0, 43.0),
            "T-35 кВ" to ReliabilityIndicators(0.02, 80.0, 1.0, 28.0),
            "T-10 кВ (кабельна мережа 10 кВ)" to ReliabilityIndicators(0.005, 60.0, 0.5, 10.0),
            "T-10 кВ (повітряна мережа 10 кВ)" to ReliabilityIndicators(0.05, 60.0, 0.5, 10.0),
            "B-110 кВ (елегазовий)" to ReliabilityIndicators(0.01, 30.0, 0.1, 30.0),
            "B-10 кВ (малооливний)" to ReliabilityIndicators(0.02, 15.0, 0.33, 15.0),
            "B-10 кВ (вакуумний)" to ReliabilityIndicators(0.01, 15.0, 0.33, 15.0),
            "Збірні шини 10 кВ на 1 приєднання" to ReliabilityIndicators(0.03, 2.0, 0.167, 5.0),
            "АВ-0,38 кВ" to ReliabilityIndicators(0.05, 4.0, 0.33, 10.0),
            "ЕД 6,10 кВ" to ReliabilityIndicators(0.1, 160.0, 0.5, 0.0),
            "ЕД 0,38 кВ" to ReliabilityIndicators(0.1, 50.0, 0.5, 0.0)
        )

        // Мапа полів вводу
        val amountMap = mapOf(
            "ПЛ-110 кВ" to findViewById<EditText>(R.id.etPL110),
            "ПЛ-35 кВ" to findViewById<EditText>(R.id.etPL35),
            "ПЛ-10 кВ" to findViewById<EditText>(R.id.etPL10),
            "КЛ-10 кВ (траншея)" to findViewById<EditText>(R.id.etKL10Trench),
            "КЛ-10 кВ (кабельний канал)" to findViewById<EditText>(R.id.etKL10Channel),
            "T-110 кВ" to findViewById<EditText>(R.id.etT110),
            "T-35 кВ" to findViewById<EditText>(R.id.etT35),
            "T-10 кВ (кабельна мережа 10 кВ)" to findViewById<EditText>(R.id.etT10Cable),
            "T-10 кВ (повітряна мережа 10 кВ)" to findViewById<EditText>(R.id.etT10Air),
            "B-110 кВ (елегазовий)" to findViewById<EditText>(R.id.etB110),
            "B-10 кВ (малооливний)" to findViewById<EditText>(R.id.etB10Oil),
            "B-10 кВ (вакуумний)" to findViewById<EditText>(R.id.etB10Vacuum),
            "Збірні шини 10 кВ на 1 приєднання" to findViewById<EditText>(R.id.etBusbars),
            "АВ-0,38 кВ" to findViewById<EditText>(R.id.etAV038),
            "ЕД 6,10 кВ" to findViewById<EditText>(R.id.etED610),
            "ЕД 0,38 кВ" to findViewById<EditText>(R.id.etED038)
        )


        val calcButton = findViewById<Button>(R.id.calcButton)
        val back_Button: Button = findViewById(R.id.backButton)

        calcButton.setOnClickListener {
            // Отримання введених даних
            val inputValues = amountMap.mapValues { (_, editText) ->
                editText.text.toString().toIntOrNull() ?: 0
            }

            // Обчислення
            val results = calculateReliability(inputValues, dataIndicators)

            // Передаємо результати до активності виводу
            val output = "Частота відмов одноколової" +
                    " системи : " + "%.2f".format(results[0]).toDouble() + " рік⁻¹\n\n" +
                    "Середня тривалість відновлення :" + "%.1f".format(results[1]).toDouble() + " год\n\n" +
                    "Коефіціент аварійного простою" +
                    " одноколової системи: " + "%.5f".format(results[2]).toDouble() + "\n\n" +
                    "Коефіціент планового простою" +
                    " одноколової системи: " + "%.5f".format(results[3]).toDouble() + "\n\n" +
                    "Частота відмов одночасно двох кіл двоколової" +
                    " системи: " + "%.5f".format(results[4]).toDouble() + "рік⁻¹\n\n" +
                    "Частота відмов двоколової системи з урахуванням " +
                    "секційного вимикача: " + "%.5f".format(results[5]).toDouble() + "рік⁻¹\n\n"

            intent = Intent(this, ResultActivity::class.java)
            intent.putExtra("output", output)
            startActivity(intent)
        }

        // Створюємо обробку натискання на кнопку повернення
        back_Button.setOnClickListener{
            val intent = Intent(this, MainActivity::class.java)
            startActivity(intent)
        }
    }

    // Функція обчислення
    private fun calculateReliability(
        amountMap: Map<String, Int>,
        dataIndicators: Map<String, ReliabilityIndicators>
    ): List<Double> {
        var wOc = 0.0
        var tVOc = 0.0

        dataIndicators.forEach { (key, indicator) ->
            val amount = amountMap[key] ?: 0
            if (amount > 0) {
                wOc += amount * indicator.omega
                tVOc += amount * indicator.tV * indicator.omega
            }
        }

        if (wOc > 0) {
            tVOc /= wOc
        }

        val kAOc = (tVOc * wOc) / 8760
        val kPOs = 1.2 * 43 / 8760
        val wDk = 2 * wOc * (kAOc + kPOs)

        return listOf(wOc, tVOc, kAOc, kPOs, wDk, wDk + 0.02)
    }
}
